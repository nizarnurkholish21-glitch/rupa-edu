# Salin file ini menjadi .env.local (untuk komputer sendiri) atau isi di Vercel > Settings > Environment Variables.
# JANGAN pernah commit nilai asli ke GitHub.

# --- Supabase (database, login, storage) ---
# Dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Kunci PUBLIK saja: publishable key (sb_publishable_…) atau anon key lama. JANGAN secret/service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci rahasia, hanya untuk skrip di server (seed akun demo). Jangan diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (dipakai mulai Fase 3) ---
ANTHROPIC_API_KEY=

# --- Alamat situs (untuk tautan di email) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
